{
  "name": "agent-profile-kit",
  "version": "0.87.0",
  "private": true,
  "description": "Compose portable agent material into host-native profiles.",
  "type": "module",
  "bin": {
    "apkit": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "docs/guides",
    "README.md"
  ],
  "scripts": {
    "build": "bun run typecheck && bun build cli/index.ts --target=node --packages=bundle --outfile=dist/cli.js --silent",
    "test": "bun run test/support/suite-supervisor.ts full",
    "test:focused": "bun run test/support/suite-supervisor.ts focused",
    "test:stress": "bun run test/support/suite-supervisor.ts stress",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "bun run build"
  },
  "engines": {
    "node": ">=22"
  },
  "os": [
    "darwin"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^22",
    "smol-toml": "^1.7.0",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  }
}
