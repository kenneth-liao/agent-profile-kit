{
  "name": "agent-profile-kit",
  "version": "0.239.7",
  "description": "Keep your Skills and Context in one Workspace and install them into your projects for each coding agent you use.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenneth-liao/agent-profile-kit.git"
  },
  "type": "module",
  "bin": {
    "apkit": "./dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "docs/guides/workspace-contract.md",
    "README.md"
  ],
  "scripts": {
    "build": "bun run typecheck && bun run build:bundle",
    "build:bundle": "bun run build.ts",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "bun run build"
  },
  "engines": {
    "node": ">=22",
    "bun": "1.4.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1"
  }
}
