.DS_Store
.env
.env.*
!.env.example

# Local dependencies and generated output
node_modules
dist/
build/
coverage/
.cache/
.tmp/
tmp/

# Disposable per-issue worktrees
.worktrees/

# Agent/runtime local state
.codex/
.agents/
*.log

# Retained compatibility material (#596) intentionally records
# Host-shaped directories and paths that the repo-level ignore rules above
# would otherwise exclude; re-include them inside fixture trees only.
!test/retained/compat-0.204.0/**/.agents/
!test/retained/compat-0.204.0/**/.agents/**
!test/retained/compat-0.204.0/**/.codex/
!test/retained/compat-0.204.0/**/.codex/**

!test/migration/**/.agents/
!test/migration/**/.agents/**
!test/migration/**/.codex/
!test/migration/**/.codex/**
