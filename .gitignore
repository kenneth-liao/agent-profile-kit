.DS_Store
.env
.env.*
!.env.example

# Local dependencies and generated output
node_modules
dist/
build/
coverage/
.cache/
.tmp/
tmp/

# Disposable per-issue worktrees
.worktrees/

# Agent/runtime local state
.codex/
.agents/
*.log

# Compatibility and sample fixture material (#596, #608) intentionally records
# Host-shaped directories and paths that the repo-level ignore rules above
# would otherwise exclude; re-include them inside fixture trees only.
!test/support/fixtures/compat-0.204.0/**/.agents/
!test/support/fixtures/compat-0.204.0/**/.agents/**
!test/support/fixtures/compat-0.204.0/**/.codex/
!test/support/fixtures/compat-0.204.0/**/.codex/**
!test/support/fixtures/scattered-sample/**/.agents/
!test/support/fixtures/scattered-sample/**/.agents/**

