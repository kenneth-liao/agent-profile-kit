"--- stdout ---
Machine-facing commands for external runners and automation. Temporary Profile
  Installation behavior, JSON payloads, and exit codes are unchanged from their
  documented contract.

Usage: apkit machine <command> [arguments]

  machine install-temp <profile> <project> --host <host> [--json]
    Install a temporary Profile into one Project
  machine remove-temp <temporary-installation-id> [--json]
    Remove one temporary Profile
  machine list [temporary [--json]]
    List active temporary Profile inventory for external runners
--- stderr ---
"
`;

exports[`golden snapshots of every human view focused command help: focused-command-help 1`] = `
"--- stdout ---
Purpose: Show the complete read-only update plan for the complete fleet, the
  containing Project, or one explicit Project

Usage: apkit status [project | --here | --all | --project <path>] [--stale | --blocked] [--verbose] [--json]

Examples:
  apkit status
  apkit status --here
  apkit status ~/projects/example-project
  apkit status --all
  apkit status --blocked
  apkit status --stale --json
  apkit status --json

Writes: Nothing; this command is read-only.

Next: Run apkit update for pending work after resolving any blockers.
--- stderr ---
"
`;

